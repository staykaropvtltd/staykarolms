{
  "name": "staykarolms-backend",
  "version": "1.0.0",
  "description": "StayKaro LMS Express Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:cluster": "pm2-runtime start ecosystem.config.js --env production",
    "stop:cluster": "pm2 stop staykaro-api",
    "reload:cluster": "pm2 reload staykaro-api",
    "logs": "pm2 logs staykaro-api",
    "monit": "pm2 monit",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "rate-limit-redis": "^5.0.0"
  },
  "devDependencies": {
    "pm2": "^7.0.3"
  }
}
